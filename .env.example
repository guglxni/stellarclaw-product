# ═══════════════════════════════════════════════════════════════════════════════
# LiveClaw — Production Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Domain ──────────────────────────────────────────────────────────────────
# Your production domain (used by set-webhook.js and CORS)
DOMAIN_NAME=https://liveclaw.xyz

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Comma-separated origins for CORS
ALLOWED_ORIGINS=https://liveclaw.xyz,https://www.liveclaw.xyz

# ── Portkey.ai (Financial Governance — Self-Hosted Gateway) ─────────────────
# Dashboard: https://app.portkey.ai → Settings → API Keys
PORTKEY_API_KEY=pk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Self-hosted Portkey gateway URL (Docker on same droplet)
# Docs: https://github.com/portkey-ai/gateway
# Default: http://localhost:8787/v1 (runs as Docker container)
PORTKEY_GATEWAY_URL=http://localhost:8787/v1

# ── MiniMax LLM ─────────────────────────────────────────────────────────────
# Dashboard: https://platform.minimaxi.com → API Keys
MINIMAX_API_KEY=your-minimax-api-key-here

# ── Telegram ────────────────────────────────────────────────────────────────
# The "master" bot token used by set-webhook.js to register the payment webhook
# This is your own BotFather token for the LiveClaw orchestrator bot
TELEGRAM_MASTER_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz-1234567

# ── Cloudflare Turnstile (Invisible CAPTCHA) ────────────────────────────────
# Dashboard: https://dash.cloudflare.com → Turnstile → Your Widget
CLOUDFLARE_TURNSTILE_SECRET=0x4AAAAAAA_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Also set the SITE KEY in the frontend:
# CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAA_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# ── AppLixir (Rewarded Video Ads) ───────────────────────────────────────────
# Dashboard: https://www.applixir.com → App Settings → S2S Secret
APPLIXIR_SECRET_KEY=your-applixir-s2s-secret

# Ad reward amount per video watched (in USD)
AD_REWARD_USD=0.02

# ── Telegram Stars Conversion ──────────────────────────────────────────────
STARS_TO_USD_RATE=0.015

# ── picobot Binary ──────────────────────────────────────────────────────────
# Path to the compiled picobot Go binary
# Production: /opt/liveclaw/backend/picobot
# Development: ./picobot
PICOBOT_PATH=/opt/liveclaw/backend/picobot

# ── SQLite Database ─────────────────────────────────────────────────────────
DB_PATH=/opt/liveclaw/backend/liveclaw.db

# ── Bot Instance Isolation ──────────────────────────────────────────────────
# Per-user picobot configs and workspaces stored here
BOTS_DIR=/opt/liveclaw/bots

# Watchdog check interval (ms) — auto-restarts crashed bots
WATCHDOG_INTERVAL_MS=30000

# ── Token Encryption (AES-256-GCM) ─────────────────────────────────────────
# 32-byte key as 64-char hex string. Encrypts Telegram bot tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
