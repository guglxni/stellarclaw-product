# ═══════════════════════════════════════════════════════════════════════════
# LiveClaw Frontend — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
#
# These are PUBLIC values — safe to be seen by browsers.
# Copy to .env and fill in every value marked CHANGE_ME.
#   cp .env.example .env && nano .env
#
# The frontend deploy script (scripts/deploy-frontend.sh) reads this file
# and generates /opt/liveclaw/frontend/config.js on the static file server.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════

# ── Backend API URL ──────────────────────────────────────────────────────────
# The full URL of the backend droplet (api.liveclaw.xyz).
# This is injected as window.LIVECLAW_API_BASE in the served config.js.
LIVECLAW_API_BASE=https://api.liveclaw.xyz

# ── Google OAuth Client ID ───────────────────────────────────────────────────
# PUBLIC — safe to expose in frontend HTML.
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
# Authorized JavaScript origins must include your frontend domain.
LIVECLAW_GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID

# ── Cloudflare Turnstile Site Key ────────────────────────────────────────────
# PUBLIC — safe to expose in frontend HTML.
# https://dash.cloudflare.com → Turnstile → your site → Site Key
# Dev test key (always passes): 1x00000000000000000000AA
LIVECLAW_TURNSTILE_SITE_KEY=CHANGE_ME_TURNSTILE_SITE_KEY

# ── AppLixir Zone ID (DEFERRED) ──────────────────────────────────────────────
# Ad-based credits are deferred. Leave blank or remove.
# LIVECLAW_APPLIXIR_ZONE_ID=

# ── Dodo Payments ───────────────────────────────────────────────────────────────
# No frontend API key needed — Dodo uses server-side checkout sessions.
# Checkout URLs are generated server-side and the user is redirected there.

# ── Analytics ────────────────────────────────────────────────────────────────────
# All analytics vars are optional. Leave blank (or omit) to disable that provider.

# PostHog — FOSS product analytics + session recording (self-hostable)
#   Repo:    https://github.com/PostHog/posthog
#   Cloud:   https://app.posthog.com (free up to 1M events/mo)
#   Self-host: docker run -d --name posthog ... (see repo README)
#   Get key: PostHog → Project Settings → Project API Key (phc_...)
LIVECLAW_POSTHOG_KEY=
#   Cloud default: https://us.i.posthog.com
#   Self-hosted:   https://your-posthog.yourdomain.com
LIVECLAW_POSTHOG_HOST=https://us.i.posthog.com

# Umami — FOSS privacy-first page analytics (self-hostable, no cookies)
#   Repo:      https://github.com/umami-software/umami
#   Cloud:     https://cloud.umami.is (free tier)
#   Self-host: docker compose up -d (see repo README, needs Postgres/MySQL)
#   UMAMI_URL: base URL of your Umami instance (no trailing slash)
LIVECLAW_UMAMI_URL=
#   Get website ID: Umami → Settings → Websites → your site → Tracking Code → data-website-id
LIVECLAW_UMAMI_WEBSITE_ID=

# GTM — Google Tag Manager (free, NOT open source)
#   Used as a container for future ad pixels (Meta, Google Ads, TikTok, etc.)
#   Once GTM is wired in, add/remove pixels from the GTM dashboard with zero code changes.
#   Get ID: https://tagmanager.google.com → create account → Container ID (GTM-XXXXXXX)
#   Also paste this same ID into Dodo Payments → Settings → Google Tag Manager toggle.
LIVECLAW_GTM_ID=

# ── Spaceship DNS API (server-side, used by marketing agent for DNS automation) ──
#   Get keys: https://www.spaceship.com/application/api-manager/ → Generate New Key
#   Never expose these in frontend HTML — backend/scripts only.
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=
