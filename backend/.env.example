# LiveClaw Orchestrator — Environment Variables
# Copy to .env and fill in your actual keys
# NEVER commit .env to version control

# ── Server ──────────────────────────────────────
PORT=3000
NODE_ENV=development

# Comma-separated origins for CORS in production
ALLOWED_ORIGINS=https://liveclaw.xyz,https://www.liveclaw.xyz

# ── Portkey.ai ──────────────────────────────────
# Get from https://app.portkey.ai → Settings → API Keys
PORTKEY_API_KEY=pk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── MiniMax ─────────────────────────────────────
# Get from https://platform.minimaxi.com → API Keys
MINIMAX_API_KEY=your-minimax-api-key

# ── picobot Binary ──────────────────────────────
# Absolute path to the compiled picobot binary
# On prod: /opt/liveclaw/backend/picobot
# On dev:  ./picobot  (place binary in backend/)
PICOBOT_PATH=./picobot

# ── SQLite Database ─────────────────────────────
DB_PATH=./liveclaw.db

# ── Cloudflare Turnstile ────────────────────────
# Get from https://dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── AppLixir Rewarded Video ─────────────────────
# Shared secret for S2S postback signature verification
APPLIXIR_SECRET_KEY=your-applixir-secret

# ── Ad reward amount in USD per video watched ───
AD_REWARD_USD=0.02

# ── Telegram Stars conversion rate ──────────────
STARS_TO_USD_RATE=0.015

# ── Token Encryption (AES-256-GCM) ─────────────
# 32-byte key as 64-char hex string for encrypting Telegram tokens at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In dev, leave empty to store tokens in plaintext (not recommended for prod)
TOKEN_ENCRYPTION_KEY=
