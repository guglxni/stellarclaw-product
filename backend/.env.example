# ═══════════════════════════════════════════════════════════════════════════
# LiveClaw Backend — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in every value marked CHANGE_ME.
#   cp .env.example .env && nano .env
#
# See CREDENTIALS.md for step-by-step instructions on obtaining each key.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Domain ──────────────────────────────────────────────────────────────────
# Full HTTPS URL of your frontend domain (used by set-webhook.js)
DOMAIN_NAME=https://liveclaw.xyz

# CORS: comma-separated list of allowed frontend origins
# Two-droplet setup: liveclaw.xyz (frontend) talks to api.liveclaw.xyz (backend)
ALLOWED_ORIGINS=https://liveclaw.xyz,https://www.liveclaw.xyz

# ── Security — Generated Keys ────────────────────────────────────────────────
# AES-256-GCM key for encrypting Telegram bot tokens at rest in SQLite.
# MUST be a 64-character hex string (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# Admin dashboard / all /admin/* endpoint auth header value.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_SECRET=CHANGE_ME_RANDOM_SECRET

# HMAC signing key for Refuel Mini App URLs (anti-fraud Layer 6).
# Can reuse TOKEN_ENCRYPTION_KEY value or generate a separate one.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MINI_APP_SECRET=CHANGE_ME_64_HEX_CHARS

# ── Telegram ────────────────────────────────────────────────────────────────
# Token for the LiveClaw master bot (@liveclaw_bot) from @BotFather.
# Used to send inline keyboard notifications for subscription renewal.
# https://t.me/BotFather → /newbot → copy the token
TELEGRAM_MASTER_BOT_TOKEN=CHANGE_ME_BOT_TOKEN

# ── Cloudflare Turnstile (Invisible CAPTCHA) ────────────────────────────────
# SECRET key — stays on the server, never exposed to frontend.
# https://dash.cloudflare.com → Turnstile → Add site → Invisible → copy Secret Key
# Dev test key (always passes): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=CHANGE_ME_TURNSTILE_SECRET_KEY

# ── Dodo Payments — Subscription Billing ────────────────────────────────────────────
# Dodo Payments handles checkout, subscriptions, customer portal, webhooks,
# and global tax/VAT as Merchant of Record. See CREDENTIALS.md §3.
# https://app.dodopayments.com → Developer → API Keys
DODO_API_KEY=CHANGE_ME_DODO_API_KEY

# Webhook signing secret — https://app.dodopayments.com → Developer → Webhooks
# Set endpoint URL to: https://api.liveclaw.xyz/webhook/dodo
DODO_WEBHOOK_SECRET=CHANGE_ME_DODO_WEBHOOK_SECRET

# Product ID from Dodo Payments Product Catalog (format: pdt_...)
# Only one product needed — unified $9.99/mo plan.
DODO_PRODUCT_ID=CHANGE_ME_PRODUCT_ID

# ── Bifrost AI Gateway ───────────────────────────────────────────────────────
# Self-hosted Go AI gateway (Docker) running on the same backend droplet.
# https://github.com/maximhq/bifrost
# MiniMax/Kimi keys are set directly in the Bifrost UI — not needed here.
BIFROST_GATEWAY_URL=http://localhost:8080

# ── OpenRouter ───────────────────────────────────────────────────────────────
# API key used in two places:
#   1. Pasted into Bifrost UI as the provider key for LLM routing
#   2. Used directly by the Vision MCP server (image_analysis tool)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_API_KEY

# ── Vision MCP Server ────────────────────────────────────────────────────────
# Image analysis tool injected into every picobot agent.
# Uses a free OpenRouter vision model — no additional cost beyond the API key above.
# VISION_DAILY_LIMIT: max image analyses per user per UTC day (generous but capped).
# VISION_MODEL: any OpenRouter vision model ID; free options listed below.
#   Free vision models (200 req/day total, best quality first):
#     qwen/qwen2.5-vl-72b-instruct:free  ← recommended
#     qwen/qwen2.5-vl-32b-instruct:free
#     google/gemini-2.0-flash-exp:free    (1M context)
#     moonshotai/kimi-vl-a3b-thinking:free
VISION_DAILY_LIMIT=80
VISION_MODEL=qwen/qwen2.5-vl-72b-instruct:free

# ── File Paths (production) ───────────────────────────────────────────────────
PICOBOT_PATH=/opt/liveclaw/backend/picobot
DB_PATH=/opt/liveclaw/backend/liveclaw.db
BOTS_DIR=/opt/liveclaw/bots

# ── Database (Production: required) ────────────────────────────────────────
# In production, DATABASE_URL must point to Managed PostgreSQL.
# Example: postgresql://doadmin:***@db-postgresql-nyc3-xxxx-do-user-xxxx-0.i.db.ondigitalocean.com:25060/defaultdb
DATABASE_URL=

# Optional PostgreSQL pool tuning
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONNECTION_TIMEOUT_MS=5000
PG_POOL_QUERY_TIMEOUT_MS=15000
PG_SSL_REJECT_UNAUTHORIZED=false
PG_APP_NAME=liveclaw-orchestrator

# ── Queue Orchestration Rollout (optional) ───────────────────────────────
# Enables command queue persistence for deploy/stop operations.
SCALE_QUEUE_ORCHESTRATION=0
# Async mode returns 202 + commandId and processes in background worker.
SCALE_QUEUE_ASYNC_MODE=0
# Worker polling interval in milliseconds (when async mode enabled).
SCALE_QUEUE_POLL_MS=1500

# ── Watchdog ─────────────────────────────────────────────────────────────────
# How often (ms) to check for crashed/zombie picobot processes.
WATCHDOG_INTERVAL_MS=30000
