{
  "name": "liveclaw-backend",
  "version": "2.0.0",
  "description": "LiveClaw Orchestrator — spawns isolated picobot agents per Telegram user",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/mcp.test.js",
    "test:integration": "vitest run tests/api.test.js tests/subscription.test.js tests/webhooks.test.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=test-results.xml",
    "sync": "node sync.js",
    "sync:watch": "node sync.js --interval",
    "lint": "eslint server.js bifrost.js dodo.js --max-warnings 15",
    "validate": "npm run lint && npm run test"
  },
  "keywords": [
    "liveclaw",
    "picobot",
    "telegram",
    "ai-agent",
    "bifrost"
  ],
  "author": "Aaryan Guglani",
  "license": "PROPRIETARY",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dodo-sync": "^0.4.0",
    "dodopayments": "^2.31.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "otpauth": "^9.5.1",
    "pg": "^8.20.0",
    "@stellar/stellar-sdk": "^15.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.2",
    "fast-check": "^4.6.0",
    "supertest": "^7.2.2",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "flatted": "^3.4.1"
  }
}
