# ═══════════════════════════════════════════════════════════════════
# LiveClaw — .gitignore
# ═══════════════════════════════════════════════════════════════════

# ── Dependencies ──────────────────────────────────────────────────
node_modules/

# ── Environment & Secrets ─────────────────────────────────────────
.env
.env.local
.env.production
!.env.example

# Runtime-generated frontend config — built from secrets in CI, never commit
liveclaw-web/www/config.js

# ── Keychain export files (never commit these) ────────────────────
# Generated by: scripts/keychain-secrets.sh
secrets.env
secrets.json
.secrets
*.secret
liveclaw-secrets.*

# ── Database ──────────────────────────────────────────────────────
*.db
*.db-journal
*.db-wal

# ── Binaries ──────────────────────────────────────────────────────
backend/picobot
picobot
.picobot-version

# ── Coverage ─────────────────────────────────────────────────────
coverage/

# ── OS & IDE ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ── Build artifacts ───────────────────────────────────────────────
dist/
build/
.next/
out/

# ── Logs ──────────────────────────────────────────────────────────
*.log
npm-debug.log*
pm2-*.log

# ── Temporary build scripts (used during initial setup — now deleted) ─────
# fix_all.py
# fix_marquee_footer.py
# refactor_frontend.py
# repomix-output.xml

# ── AI Agent directories ─────────────────────────────────────────
.agents/
.agent/
_agents/
_agent/
.gemini/
*.db-shm
*.db-wal
