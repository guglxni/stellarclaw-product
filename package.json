{
    "name": "liveclaw",
    "version": "2.0.0",
    "description": "LiveClaw — Subscription AI agent platform for Telegram",
    "private": true,
    "scripts": {
        "frontend": "python3 -m http.server 8080 --directory liveclaw-web/www",
        "backend": "cd backend && npm run dev",
        "test": "cd backend && npm test",
        "lint": "cd backend && npm run lint",
        "deploy:backend": "bash scripts/deploy-backend.sh",
        "deploy:frontend": "bash scripts/deploy-frontend.sh",
        "deploy:backend:code": "bash scripts/deploy-backend.sh --code-only",
        "deploy:frontend:code": "bash scripts/deploy-frontend.sh --code-only",
        "update:picobot": "bash scripts/update-picobot.sh"
    },
    "keywords": [
        "liveclaw",
        "telegram",
        "ai-agent",
        "picobot",
        "minimax",
        "bifrost",
        "subscription"
    ],
    "author": "Aaryan Guglani",
    "license": "UNLICENSED"
}